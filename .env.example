# Local demo only. Replace every development value before any hosted deployment.
POSTGRES_PASSWORD=replace-with-a-local-database-password
SUPPORTIQ_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_COOKIE_SECURE=false
LOCAL_AUTH_LINK_EXPOSURE=true
SEED_DEMO_ADMIN=true
DEMO_ADMIN_EMAIL=replace-with-your-local-demo-email
DEMO_ADMIN_PASSWORD=replace-with-a-unique-local-demo-password
DEMO_ADMIN_NAME=ShopSmart Demo Admin
GEMINI_MODEL=gemini-3.8-flash
EMBEDDING_PROVIDER=gemini
# Optional server-side Google Gemini API key for grounded answer generation and embeddings.
# Leave empty to use deterministic local embeddings, extractive matching, and safe handoff.
GEMINI_API_KEY=
# Optional separate server-side key for embeddings; falls back to GEMINI_API_KEY when blank.
GEMINI_EMBEDDING_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Set to local to force local embeddings even when a Gemini embedding key is available.
# EMBEDDING_PROVIDER=local
PAYMENT_PROVIDER=DEMO
PAYMENT_LIVE_ENABLED=false
PAYMENT_WEBHOOK_SECRET=replace-with-a-unique-local-webhook-secret
BILLING_PROVIDER=DEMO
BILLING_WEBHOOK_SECRET=replace-with-a-unique-local-webhook-secret
BILLING_GRACE_DAYS=7
# Optional platform operator. Configure both values locally to create a SUPER_ADMIN account.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=SupportIQ Platform Admin
RAG_CHUNK_SIZE=1800
RAG_CHUNK_OVERLAP=240
# Leave true for the simple single-backend local setup. If using Compose's dedicated-worker profile, set false.
AI_PROCESSING_DISPATCH_LOCALLY=true
